<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>EntraUserSync-$(Version)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ServicePublishDir Condition="'$(ServicePublishDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\artifacts\publish\service'))</ServicePublishDir>
  </PropertyGroup>

  <PropertyGroup>
    <_ServicePublishDirNormalized>$([System.IO.Path]::GetFullPath('$(ServicePublishDir)').TrimEnd('\').TrimEnd('/'))\</_ServicePublishDirNormalized>
    <DefineConstants>$(DefineConstants);ServicePublishDir=$(_ServicePublishDirNormalized)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Package.wxs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
