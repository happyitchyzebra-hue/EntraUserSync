<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>EntraUserSync.Core</RootNamespace>
    <Description>Core library for EntraUserSync Windows service agent</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Agent is Windows-only at runtime; CA1416 noise from shared net10.0 TFM is expected. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.78.0" />
    <PackageReference Include="System.DirectoryServices" Version="10.0.0" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.0" />
  </ItemGroup>

</Project>
