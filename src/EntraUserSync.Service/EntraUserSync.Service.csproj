<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>EntraUserSync.Service</RootNamespace>
    <AssemblyName>EntraUserSync</AssemblyName>
    <Description>EntraUserSync user-session agent (runs as the logged-on user)</Description>
    <UserSecretsId>dotnet-EntraUserSync.Service-5b7e55fc-9ed7-4385-a6e6-10ca73af94b6</UserSecretsId>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EntraUserSync.Core\EntraUserSync.Core.csproj" />
  </ItemGroup>
</Project>
